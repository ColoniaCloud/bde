# Nunca guardes las credenciales reales en GitHub.
# Copiá este archivo a .env.local (desarrollo) o .env.production (VPS).
#
# Las variables se validan al arrancar con Zod (lib/env.server.ts y
# lib/env.public.ts). Si una está presente pero malformada, la app falla de
# entrada con un mensaje que dice cuál. Las opcionales pueden faltar: la
# funcionalidad que dependa de ellas responde 503 con un mensaje entendible.

# ── Obligatorias ─────────────────────────────────────────────────────────────
# Sin estas dos el build falla: se incrustan en el bundle del navegador y sin
# ellas el cliente de Supabase no puede inicializarse.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Dirección pública de la tienda ───────────────────────────────────────────
# Necesaria en producción: de acá salen las URLs de retorno y de webhook que se
# le mandan a Mercado Pago. En desarrollo, si falta, se usa http://localhost:3000
SITE_URL=https://boutiquedeleste.com

# ── Mercado Pago (opcional) ──────────────────────────────────────────────────
# Si faltan, el botón de pago responde 503 y el cliente puede seguir por WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Correo SMTP (opcional) ───────────────────────────────────────────────────
# Envía la orden al cliente y una copia oculta a la casilla interna.
# Si falta cualquiera de host, user, pass o copy, no se emiten comprobantes.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ventas@boutiquedeleste.com
SMTP_PASS=xxxxxxxxxxxxxxxx
ORDER_FROM_EMAIL=ventas@boutiquedeleste.com
ORDER_COPY_EMAIL=correo-de-freddy@ejemplo.com

# ── Numeración de órdenes ────────────────────────────────────────────────────
# Carpeta persistente y escribible del VPS. No debe borrarse en cada publicación.
# Si falta, se usa ./data dentro del proyecto, que sí se pierde al redesplegar.
ORDER_DATA_DIR=/var/lib/boutiquedeleste
