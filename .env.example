# Nunca guardes las credenciales reales en GitHub.
# Copiá este archivo a .env.local (desarrollo) o .env.production (VPS).
#
# Las variables se validan al arrancar con Zod (lib/env.server.ts y
# lib/env.public.ts). Si una está presente pero malformada, la app falla de
# entrada con un mensaje que dice cuál. Las opcionales pueden faltar: la
# funcionalidad que dependa de ellas responde 503 con un mensaje entendible.

# ── Panel de administración (Payload) ────────────────────────────────────────
# Sin estas dos la aplicación no arranca.
DATABASE_URI=postgres://boutique:CAMBIAR@localhost:5432/boutique
# Firma las sesiones del panel. Generala con: openssl rand -base64 48
# Si la cambiás, se cierran todas las sesiones abiertas del panel.
PAYLOAD_SECRET=generar-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres

# ── Dirección pública de la tienda ───────────────────────────────────────────
# Necesaria en producción: de acá salen las URLs de retorno y de webhook que se
# le mandan a Mercado Pago. En desarrollo, si falta, se usa http://localhost:3000
SITE_URL=https://boutiquedeleste.com

# ── Mercado Pago (opcional) ──────────────────────────────────────────────────
# Si faltan, el botón de pago responde 503 y el cliente puede seguir por WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Asistente de precios con Groq (opcional) ─────────────────────────────────
# Sin la clave, subir un PDF avisa que no está configurado; el resto sigue igual.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verificado el 2026-09-10 contra GET https://api.groq.com/openai/v1/models:
# qwen/qwen3.6-27b y qwen/qwen3.8-27b existen y ambos soportan json_schema y
# visión. Son intercambiables sin tocar código. Groq depreca modelos con
# frecuencia (llama-4-scout quedó obsoleto en junio de 2026), así que conviene
# volver a confirmarlo en cada despliegue:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY" | grep -o '"id":"[^"]*"'
GROQ_MODEL=qwen/qwen3.6-27b

# ── Ingreso con Google (opcional) ────────────────────────────────────────────
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth.
# Agregá esta URI de redirección autorizada:
#   https://boutiquedeleste.com/api/auth/google/callback
# Sin estas dos, la página de cuenta lo dice y no ofrece el botón.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Correo SMTP (opcional) ───────────────────────────────────────────────────
# Envía la orden al cliente y una copia oculta a la casilla interna.
# Si falta cualquiera de host, user, pass o copy, no se emiten comprobantes.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ventas@boutiquedeleste.com
SMTP_PASS=xxxxxxxxxxxxxxxx
ORDER_FROM_EMAIL=ventas@boutiquedeleste.com
ORDER_COPY_EMAIL=correo-de-freddy@ejemplo.com

# ── Conciliación de pagos (opcional) ─────────────────────────────────────────
# Horas que espera antes de reconsultar una orden pendiente. Por defecto 2.
RECONCILE_AFTER_HOURS=2
